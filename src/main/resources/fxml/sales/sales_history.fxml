<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="10.0"
      style="-fx-background-color: #F8FAFC;"
      stylesheets="@../../css/inventory.css, @../../css/inventory_history.css, @../../css/sales.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.sales.SalesHistoryController">

    <padding>
        <Insets bottom="10.0" left="20.0" right="20.0" top="8.0" />
    </padding>

    <!-- HEADER: Tiêu đề + Phân quyền + Bộ lọc theo ngày & Ô tìm kiếm & Nút ✕ -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <VBox spacing="2.0">
            <Label styleClass="history-main-title" text="Lịch sử bán hàng" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Cụm công cụ: Ô tìm kiếm nhanh + Lọc theo ngày + Nút ✕ đóng -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <!-- Ô tìm kiếm nhanh theo mã đơn, SĐT, tên thu ngân -->
            <TextField fx:id="txtSearch" prefWidth="240.0"
                       promptText="Tìm theo mã đơn, SĐT khách..."
                       styleClass="search-input" />

            <!-- Lọc theo ngày (mặc định hôm nay) -->
            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <Label styleClass="filter-label" text="Ngày:" />
                <DatePicker fx:id="dpFilterDate" prefWidth="145.0" promptText="dd/MM/yyyy" styleClass="history-datepicker" />
                <Button fx:id="btnFilterDate" onAction="#handleFilterDate" styleClass="btn-funnel-filter">
                    <graphic>
                        <SVGPath content="M2 3h20l-8 9.5v6.5l-4 2v-8.5L2 3z" styleClass="funnel-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip fx:id="tooltipFilter" text="Nhấn để áp dụng lọc theo ngày" />
                    </tooltip>
                </Button>
            </HBox>

            <!-- Nút ✕ đóng lịch sử quay lại màn hình bán hàng -->
            <Button fx:id="btnClose" onAction="#handleClose" styleClass="btn-close-history" text="✕" />
        </HBox>
    </HBox>

    <!-- KHU VỰC BẢNG LỊCH SỬ ĐƠN HÀNG -->
    <StackPane VBox.vgrow="ALWAYS">
        <HBox minHeight="320.0" spacing="0.0" styleClass="table-float-container" VBox.vgrow="ALWAYS">
            <TableView fx:id="tableSalesOrders" HBox.hgrow="ALWAYS" styleClass="custom-inventory-table, history-master-table, table-scrollable-data">
                <columns>
                    <TableColumn fx:id="colIndex" minWidth="65.0" prefWidth="70.0" text="STT" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colCode" minWidth="150.0" prefWidth="160.0" text="Mã đơn hàng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colDateTime" minWidth="160.0" prefWidth="175.0" text="Thời gian bán" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colEmployee" minWidth="180.0" prefWidth="220.0" text="Thu ngân" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colCustomerPhone" minWidth="130.0" prefWidth="150.0" text="SĐT khách hàng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colItemSummary" minWidth="160.0" prefWidth="185.0" text="Số mặt hàng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colSubtotal" minWidth="140.0" prefWidth="160.0" text="Tiền hàng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colDiscount" minWidth="120.0" prefWidth="135.0" text="Giảm giá" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colTotalAmount" minWidth="150.0" prefWidth="175.0" text="Tổng thanh toán" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                    <TableColumn fx:id="colPaymentMethod" minWidth="120.0" prefWidth="135.0" text="Hình thức" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </HBox>

        <!-- Trạng thái trống (Empty State khi không có đơn trong ngày) -->
        <VBox fx:id="paneEmptyHistory" alignment="CENTER" spacing="10.0" visible="false" mouseTransparent="true">
            <Label styleClass="empty-title" text="Không có đơn hàng nào trong ngày này" style="-fx-font-size: 15px; -fx-text-fill: #64748B; -fx-font-family: 'Inter 18pt SemiBold';" />
            <Label text="Vui lòng chọn ngày khác hoặc thực hiện bán hàng mới." style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" />
        </VBox>
    </StackPane>

    <!-- THANH ĐIỀU HƯỚNG PHÂN TRANG -->
    <HBox alignment="CENTER" prefHeight="36.0" spacing="12.0">
        <VBox.margin>
            <Insets top="12.0" />
        </VBox.margin>
        <Region HBox.hgrow="ALWAYS" />
        <HBox fx:id="paginationBox" alignment="CENTER" spacing="6.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblRecordRange"
               alignment="CENTER"
               prefHeight="34.0"
               minWidth="100.0"
               prefWidth="110.0"
               maxWidth="130.0"
               styleClass="pagination-record-badge"
               text="0 - 0" />
    </HBox>

</VBox>
