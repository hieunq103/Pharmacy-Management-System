<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="690.0" spacing="16.0"
      styleClass="payment-dialog-root"
      stylesheets="@../../css/sales.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.sales.PaymentDialogController">

    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <!-- HEADER / TOTAL AMOUNT & FORMULA BREAKDOWN -->
    <VBox spacing="8.0" styleClass="payment-breakdown-card">
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="payment-summary-label" text="Tổng tiền hàng:" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblDialogSubtotal" styleClass="payment-summary-value" text="0đ" />
        </HBox>
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="payment-summary-label" text="Giảm giá:" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblDialogDiscount" styleClass="payment-summary-discount" text="-0đ" />
        </HBox>
        <Region styleClass="payment-summary-divider" />
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="2.0">
                <Label styleClass="payment-header-sub" text="Tổng thanh toán:" />
                <Label styleClass="payment-formula-hint" text="(Tổng tiền hàng - Giảm giá)" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalAmount" styleClass="payment-total-amount" text="0đ" />
        </HBox>
    </VBox>

    <!-- CHỌN PHƯƠNG THỨC THANH TOÁN (TIỀN MẶT / CHUYỂN KHOẢN) -->
    <VBox spacing="8.0">
        <Label styleClass="field-label" text="Phương thức thanh toán" />
        <HBox spacing="12.0">
            <Button fx:id="btnMethodCash" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="315.0" prefWidth="315.0" minHeight="44.0" prefHeight="44.0" maxHeight="44.0" onAction="#handleSelectCash" styleClass="payment-method-btn" text="Tiền mặt" />
            <Button fx:id="btnMethodTransfer" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="315.0" prefWidth="315.0" minHeight="44.0" prefHeight="44.0" maxHeight="44.0" onAction="#handleSelectTransfer" styleClass="payment-method-btn" text="Chuyển khoản" />
        </HBox>
    </VBox>

    <!-- KHUNG CHI TIẾT THEO PHƯƠNG THỨC -->
    <StackPane VBox.vgrow="ALWAYS" minHeight="330.0">
        <!-- 1. KHUNG TIỀN MẶT -->
        <VBox fx:id="paneCash" minHeight="330.0" spacing="16.0" styleClass="payment-detail-box" alignment="CENTER">
            <!-- Ô nhập tiền khách đưa -->
            <VBox spacing="12.0" styleClass="cash-entry-card">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label styleClass="cash-entry-label" text="Tiền khách đưa:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtCashGiven" alignment="CENTER_RIGHT" prefWidth="280.0" promptText="0" styleClass="cash-input" />
                </HBox>

                <!-- Gợi ý tiền nhanh -->
                <HBox fx:id="boxQuickAmounts" alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnExactAmount" onAction="#handleExactCash" styleClass="quick-amount-chip" text="Vừa đủ" />
                    <Button fx:id="btnQuick1" onAction="#handleQuickAmount1" styleClass="quick-amount-chip" text="400.000" />
                    <Button fx:id="btnQuick2" onAction="#handleQuickAmount2" styleClass="quick-amount-chip" text="500.000" />
                </HBox>
            </VBox>

            <!-- Thẻ hiển thị Tiền thừa trả khách to nổi bật -->
            <HBox alignment="CENTER_LEFT" styleClass="change-card">
                <VBox spacing="4.0">
                    <Label styleClass="change-card-title" text="Tiền thừa trả khách:" />
                    <Label styleClass="change-card-hint" text="Số tiền cần hoàn trả lại cho khách" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblChangeAmount" styleClass="change-card-value" text="0đ" />
            </HBox>
        </VBox>

        <!-- 2. KHUNG CHUYỂN KHOẢN -->
        <VBox fx:id="paneTransfer" minHeight="330.0" spacing="12.0" styleClass="payment-detail-box" visible="false">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="transfer-info-title" text="Thông tin chuyển khoản" />
            </HBox>

            <HBox alignment="CENTER" spacing="18.0" VBox.vgrow="ALWAYS">
                <!-- Mã QR Container (Kích thước lớn 230x230 rõ nét) -->
                <VBox alignment="CENTER" spacing="8.0" styleClass="qr-wrapper-card" minWidth="250.0" prefWidth="250.0">
                    <StackPane alignment="CENTER" minWidth="230.0" prefWidth="230.0" maxWidth="230.0" minHeight="230.0" prefHeight="230.0" maxHeight="230.0">
                        <ImageView fx:id="imgQrCode" fitWidth="230.0" fitHeight="230.0" preserveRatio="true" />
                        <ProgressIndicator fx:id="progressQr" maxWidth="40.0" maxHeight="40.0" />
                        <VBox fx:id="boxSuccessOverlay" alignment="CENTER" spacing="6.0" styleClass="qr-success-overlay" visible="false">
                            <Label styleClass="qr-success-icon" text="✓" />
                            <Label styleClass="qr-success-text" text="Đã nhận tiền!" />
                        </VBox>
                    </StackPane>
                    <Label styleClass="qr-scan-hint" text="Quét bằng mọi App Ngân hàng" />
                </VBox>

                <!-- Thông tin chuyển khoản -->
                <VBox spacing="10.0" styleClass="transfer-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_LEFT">
                        <Label minWidth="105.0" prefWidth="105.0" styleClass="transfer-field-name" text="Ngân hàng:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblBankName" styleClass="transfer-field-val" text="MB Bank" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label minWidth="105.0" prefWidth="105.0" styleClass="transfer-field-name" text="Số tài khoản:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblAccountNo" styleClass="transfer-field-val, bold" text="0989261809" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label minWidth="105.0" prefWidth="105.0" styleClass="transfer-field-name" text="Chủ tài khoản:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblAccountName" styleClass="transfer-field-val" text="NGUYEN QUANG HIEU" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label minWidth="105.0" prefWidth="105.0" styleClass="transfer-field-name" text="Số tiền:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTransferAmount" styleClass="transfer-field-val, text-primary" text="0đ" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label minWidth="105.0" prefWidth="105.0" styleClass="transfer-field-name" text="Nội dung:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTransferContent" styleClass="transfer-content-badge" text="HDB..." />
                    </HBox>
                </VBox>
            </HBox>

            <!-- Trạng thái lắng nghe giao dịch tự động -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="transfer-status-bar">
                <Label fx:id="lblStatusPulse" styleClass="status-pulse-dot" text="●" />
                <Label fx:id="lblTransferStatus" styleClass="transfer-status-text" text="Đang chờ chuyển khoản..." HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- PRESCRIPTION WARNING BOX (CHỈ HIỂN THỊ KHI ĐƠN CÓ THUỐC KÊ TOA) -->
    <VBox fx:id="boxPrescriptionWarning" spacing="10.0" styleClass="prescription-warning-box">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label minWidth="18.0" prefWidth="18.0" styleClass="prescription-warning-icon" text="⚠" />
            <Label styleClass="prescription-warning-title" text="Đơn có thuốc kê toa — phải kiểm tra đơn của bác sĩ trước khi bán." wrapText="true" HBox.hgrow="ALWAYS" />
        </HBox>
        <CheckBox fx:id="chkPrescriptionConfirmed" styleClass="prescription-checkbox" text="Tôi đã kiểm tra đơn thuốc của khách hàng" />
    </VBox>

    <!-- FOOTER ACTIONS -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding>
            <Insets top="4.0" />
        </padding>
        <Label fx:id="lblPrescriptionHint" styleClass="prescription-hint-text" text="Cần xác nhận đã kiểm tra đơn thuốc" wrapText="true" HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" minWidth="110.0" prefWidth="110.0" minHeight="44.0" prefHeight="44.0" styleClass="btn-modal-cancel" text="Quay lại" />
        <Button fx:id="btnConfirmPayment" onAction="#handleConfirmPayment" minWidth="185.0" prefWidth="185.0" minHeight="44.0" prefHeight="44.0" styleClass="btn-modal-confirm" text="Xác nhận thanh toán" />
    </HBox>

</VBox>
