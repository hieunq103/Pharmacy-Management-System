<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.inventory.ui.ExportDialogController"
      prefWidth="1060.0"
      maxWidth="1100.0"
      style="-fx-background-color: #FFFFFF; -fx-background: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-width: 0 0 0 1px; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.2), 25, 0, -6, 0);"
      stylesheets="@../../css/add_employee.css, @../../css/inventory.css"
      styleClass="drawer-panel">

    <!-- ==================== HEADER ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16 24; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-background-color: #FFFFFF;">
        <VBox spacing="2">
            <Label text="Lập Phiếu Xuất Kho" style="-fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 18px; -fx-text-fill: #1E293B;"/>
            <Label text="Xuất danh sách nhiều mặt hàng thuốc với từng lý do xuất hủy, thu hồi hoặc chuyển trả NCC cụ thể" style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ==================== BODY (SCROLLABLE) ==================== -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #FFFFFF; -fx-background: #FFFFFF; -fx-border-width: 0;">
        <VBox spacing="16" style="-fx-padding: 18 24; -fx-background-color: #FFFFFF;">

            <!-- 1. THÔNG TIN CHUNG PHIẾU XUẤT -->
            <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12 16;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="1. Thông tin chung đợt xuất" styleClass="form-label" style="-fx-font-size: 14px; -fx-text-fill: #0F172A;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Người lập phiếu:" style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                        <Label fx:id="lblEmployeeName" text="Admin / Nhân viên" style="-fx-font-family: 'Inter 18pt SemiBold'; -fx-text-fill: #0F172A; -fx-font-size: 13px;"/>
                    </HBox>
                </HBox>

                <!-- Ghi chú chung đợt xuất -->
                <VBox spacing="4">
                    <Label text="Ghi chú đợt xuất kho (Số quyết định, biên bản hủy, căn cứ văn bản...)" styleClass="form-label"/>
                    <TextField fx:id="txtNote" promptText="Nhập ghi chú chung cho đợt xuất kho này (nếu có)..." styleClass="form-input"/>
                </VBox>
            </VBox>

            <!-- 2. KHU VỰC THÊM MẶT HÀNG VÀO PHIẾU XUẤT -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-border-color: #0066FF; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 14 16;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="2. Thêm thuốc vào phiếu xuất" styleClass="form-label" style="-fx-font-size: 14px; -fx-text-fill: #0066FF;"/>
                </HBox>

                <!-- Tìm kiếm và chọn thuốc -->
                <VBox spacing="6">
                    <Label text="Nhập mã thuốc hoặc tên thuốc cần xuất kho *" styleClass="form-label"/>
                    <StackPane fx:id="medicinePickerContainer"/>
                    <Label fx:id="lblErrorMedicine" text="" styleClass="form-error-msg" visible="false" managed="false"/>

                    <!-- Card thông tin thuốc đã chọn -->
                    <HBox fx:id="boxMedicineInfo" alignment="CENTER_LEFT" spacing="16"
                          style="-fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12;"
                          visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Mã:" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
                            <Label fx:id="lblMedCode" text="MED000" style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 11px; -fx-background-radius: 4px; -fx-padding: 2 6;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Thuốc:" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
                            <Label fx:id="lblMedName" text="—" style="-fx-text-fill: #0F172A; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 13px;"/>
                        </HBox>
                        <Label fx:id="lblMedCategory" text="Nhóm: —" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblMedTotalStock" text="Tổng tồn: 0" style="-fx-font-family: 'Inter 18pt SemiBold'; -fx-text-fill: #0066FF; -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>

                <!-- Header tiêu đề các cột nhập lô -->
                <GridPane hgap="12" alignment="CENTER_LEFT">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="38.0"/>
                        <ColumnConstraints percentWidth="22.0"/>
                        <ColumnConstraints percentWidth="35.0"/>
                        <ColumnConstraints percentWidth="5.0"/>
                    </columnConstraints>
                    <Label text="Chọn lô hàng xuất *" styleClass="form-label" GridPane.columnIndex="0"/>
                    <Label text="Số lượng xuất *" styleClass="form-label" GridPane.columnIndex="1"/>
                    <Label text="Lý do xuất của thuốc này *" styleClass="form-label" GridPane.columnIndex="2"/>
                    <Label text="" GridPane.columnIndex="3"/>
                </GridPane>

                <!-- Container chứa các dòng lô động (mỗi lần bấm 'Xuất thêm lô khác' sẽ thêm 1 dòng 3 ô vào đây) -->
                <VBox fx:id="lotRowsContainer" spacing="10"/>

                <!-- Hàng nút Thao tác: Xuất thêm lô khác & Thêm vào phiếu xuất -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button fx:id="btnSelectAnotherLot" text="+ Xuất thêm lô khác" onAction="#handleSelectAnotherLot"
                            style="-fx-background-color: #EFF6FF; -fx-text-fill: #0066FF; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 12px; -fx-padding: 7 14; -fx-border-color: #BFDBFE; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-cursor: hand;"/>
                    <Label fx:id="lblItemError" text="" styleClass="form-error-msg" visible="false" managed="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddItem" text="+ Thêm vào phiếu xuất" onAction="#handleAddItemToList"
                            style="-fx-background-color: #0066FF; -fx-text-fill: #FFFFFF; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 13px; -fx-background-radius: 6px; -fx-padding: 8 20; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- 3. BẢNG DANH SÁCH CÁC MẶT HÀNG TRONG PHIẾU XUẤT -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="3. Danh sách mặt hàng đã thêm vào phiếu xuất" styleClass="form-label" style="-fx-font-size: 14px; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="lblItemCountBadge" text="0 mặt hàng"
                           style="-fx-background-color: #EFF6FF; -fx-text-fill: #0066FF; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 11.5px; -fx-padding: 2 8; -fx-background-radius: 10px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnClearAllItems" text="Xóa tất cả" onAction="#handleClearAllItems"
                            style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>

                <!-- Khung bao viền ngoài bo góc chuẩn như bảng Kho thuốc (table-float-container) -->
                <HBox minHeight="240.0" prefHeight="280.0" spacing="0.0" styleClass="table-float-container">
                    <TableView fx:id="tableItems" HBox.hgrow="ALWAYS" styleClass="custom-inventory-table, table-scrollable-data, import-items-table">
                        <columns>
                            <TableColumn fx:id="colIndex" styleClass="lot-col-left" minWidth="60.0" prefWidth="65.0" resizable="false" sortable="false" text="STT" />
                            <TableColumn fx:id="colCode" styleClass="lot-col-left" minWidth="95.0" prefWidth="105.0" resizable="true" sortable="false" text="Mã thuốc" />
                            <TableColumn fx:id="colName" styleClass="lot-col-left" minWidth="190.0" prefWidth="220.0" resizable="true" sortable="false" text="Tên thuốc" />
                            <TableColumn fx:id="colCategory" styleClass="lot-col-left" minWidth="150.0" prefWidth="180.0" resizable="true" sortable="false" text="Nhóm thuốc" />
                            <TableColumn fx:id="colLot" styleClass="lot-col-left" minWidth="120.0" prefWidth="135.0" resizable="true" sortable="false" text="Số lô" />
                            <TableColumn fx:id="colExpiry" styleClass="lot-col-left" minWidth="135.0" prefWidth="150.0" resizable="true" sortable="false" text="Hạn sử dụng" />
                            <TableColumn fx:id="colUnit" styleClass="lot-col-left" minWidth="75.0" prefWidth="85.0" resizable="true" sortable="false" text="Đơn vị" />
                            <TableColumn fx:id="colStock" styleClass="lot-col-left" minWidth="95.0" prefWidth="105.0" resizable="true" sortable="false" text="Tồn trong lô" />
                            <TableColumn fx:id="colQuantity" styleClass="lot-col-left" minWidth="95.0" prefWidth="105.0" resizable="true" sortable="false" text="SL xuất" />
                            <TableColumn fx:id="colReason" styleClass="lot-col-left" minWidth="280.0" prefWidth="320.0" resizable="true" sortable="false" text="Lý do xuất" />
                            <TableColumn fx:id="colAction" styleClass="lot-col-center" minWidth="90.0" prefWidth="100.0" resizable="false" sortable="false" style="-fx-alignment: CENTER;" text="Thao tác" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </HBox>
            </VBox>

            <!-- Error message tổng -->
            <Label fx:id="lblGeneralError" text="" styleClass="form-error-msg" visible="false" managed="false"/>

        </VBox>
    </ScrollPane>

    <!-- ==================== FOOTER ==================== -->
    <HBox alignment="CENTER_RIGHT" spacing="16" style="-fx-padding: 14 24; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-background-color: #F8FAFC;">
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnCancel" text="Hủy" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button fx:id="btnConfirmExport" text="Xác nhận Xuất Kho" onAction="#handleConfirmExport" styleClass="btn-primary-add"
                style="-fx-background-color: #0066FF; -fx-text-fill: white; -fx-font-family: 'Inter 18pt SemiBold'; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 8px; -fx-cursor: hand;"/>
    </HBox>

</VBox>
