<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="650.0" prefWidth="1200.0" spacing="14.0"
      styleClass="lot-dialog-root"
      stylesheets="@../../css/inventory.css, @../../css/inventory_history.css, @../../css/icon_buttons.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.inventory.ui.TransactionDetailDialogController">

    <padding>
        <Insets bottom="16.0" left="24.0" right="24.0" top="18.0" />
    </padding>

    <!-- Header: Tiêu đề + Mã phiếu + Ngày giờ -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0">
            <Label fx:id="lblDialogTitle" styleClass="lot-dialog-title" text="Chi tiết phiếu xuất nhập kho" />
            <Label fx:id="lblTransactionTime" styleClass="history-sub-title" text="Thời gian: 00:00 - 01/01/2026" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnClose" onAction="#handleClose" styleClass="btn-icon-close">
            <graphic>
                <SVGPath content="M 0 0 L 10 10 M 10 0 L 0 10" styleClass="btn-icon-glyph" />
            </graphic>
            <tooltip>
                <Tooltip text="Đóng" />
            </tooltip>
        </Button>
    </HBox>

    <!-- Card thông tin tổng quan của phiếu -->
    <VBox spacing="10.0" styleClass="lot-info-card">
        <HBox spacing="28.0" alignment="CENTER_LEFT">
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="lot-info-label" text="Người thực hiện:" />
                <Label fx:id="lblEmployee" styleClass="lot-info-value" text="—" />
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label fx:id="lblPartnerLabel" styleClass="lot-info-label" text="Đối tác:" />
                <Label fx:id="lblPartnerValue" styleClass="lot-info-value" text="—" />
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="lot-info-label" text="Ghi chú:" />
                <Label fx:id="lblNote" styleClass="lot-info-value" text="Không có ghi chú" />
            </HBox>
        </HBox>

        <HBox spacing="28.0" alignment="CENTER_LEFT">
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="lot-info-label" text="Số loại thuốc:" />
                <Label fx:id="lblItemCount" styleClass="lot-info-value-highlight" text="0 loại" />
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="lot-info-label" text="Tổng số lượng:" />
                <Label fx:id="lblTotalQuantity" styleClass="lot-info-value-highlight" text="0" />
            </HBox>
            <HBox fx:id="boxTotalAmount" spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="lot-info-label" text="Tổng tiền thanh toán:" />
                <Label fx:id="lblTotalAmount" styleClass="lot-info-value-highlight" style="-fx-text-fill: #0066FF; -fx-font-size: 15px;" text="0 đ" />
            </HBox>
        </HBox>
    </VBox>

    <!-- Thanh tìm kiếm thuốc trong phiếu -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="txtSearchDetail" prefWidth="320.0"
                   promptText="Tìm kiếm thuốc theo mã, tên thuốc, số lô..."
                   styleClass="search-input" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblRowCount" styleClass="hint-select-label" text="Danh sách các mặt hàng:" />
    </HBox>

    <!-- Bảng danh sách mặt hàng thuốc trong phiếu (cho phép cuộn ngang và cuộn dọc) -->
    <HBox minHeight="300.0" spacing="0.0" styleClass="table-float-container" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableDetails" HBox.hgrow="ALWAYS" styleClass="custom-inventory-table, history-detail-table, table-scrollable-data">
            <columns>
                <TableColumn fx:id="colIndex" minWidth="60.0" prefWidth="65.0" text="STT" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colMedCode" minWidth="110.0" prefWidth="125.0" text="Mã thuốc" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colMedName" minWidth="250.0" prefWidth="320.0" text="Tên thuốc" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colCategory" minWidth="280.0" prefWidth="290.0" text="Nhóm thuốc" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colManufacturer" minWidth="200.0" prefWidth="260.0" text="Nhà sản xuất" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colLotNumber" minWidth="210.0" prefWidth="220.0" text="Số lô" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colExpiryDate" minWidth="120.0" prefWidth="135.0" text="Hạn dùng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colUnit" minWidth="85.0" prefWidth="95.0" text="Đơn vị" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colQuantity" minWidth="95.0" prefWidth="110.0" text="Số lượng" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colUnitPrice" minWidth="130.0" prefWidth="150.0" text="Đơn giá" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colTotalPrice" minWidth="150.0" prefWidth="175.0" text="Thành tiền" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
                <TableColumn fx:id="colReason" minWidth="420.0" prefWidth="460.0" text="Lý do xuất chi tiết" style="-fx-alignment: CENTER_LEFT;" sortable="false" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </HBox>

    <!-- THANH ĐIỀU HƯỚNG PHÂN TRANG CHI TIẾT PHIẾU -->
    <HBox alignment="CENTER" prefHeight="36.0" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <HBox fx:id="detailPaginationBox" alignment="CENTER" spacing="6.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblDetailRecordRange"
               alignment="CENTER"
               prefHeight="34.0"
               minWidth="100.0"
               prefWidth="100.0"
               maxWidth="100.0"
               styleClass="pagination-record-badge"
               text="0 - 0" />
    </HBox>

</VBox>
