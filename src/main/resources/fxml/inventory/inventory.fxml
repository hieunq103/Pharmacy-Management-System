<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #F8FAFC;"
           stylesheets="@../../css/inventory.css, @../../css/inventory_history.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pharmacy.inventory.InventoryController">

    <!-- 1. VIEW DANH SÁCH THUỐC TỒN KHO -->
    <VBox fx:id="viewMedicineInventory" spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="8.0" />
        </padding>

        <!-- Header hàng 1: Thống kê -->
        <VBox spacing="4.0">
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="stat-label-primary" text="Tổng loại thuốc:" />
                <Label fx:id="lblTotalMedicines" styleClass="stat-label-primary" text="0" />
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="stat-label-primary" text="Còn hàng:" />
                <Label fx:id="lblInStockMedicines" styleClass="stat-label-primary" text="0" />
            </HBox>
        </VBox>

        <!-- Header hàng 2: Nút chức năng (sát trái) + Ô tìm kiếm (sát phải) -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <!-- Nút Nhập Kho -->
            <Button fx:id="btnImport" mnemonicParsing="false"
                    styleClass="btn-primary-import"
                    text="+ Nhập Kho" />

            <!-- Nút Xuất Kho -->
            <Button fx:id="btnExport" mnemonicParsing="false"
                    styleClass="btn-secondary-export"
                    text="Xuất Kho" />

            <!-- Nút Lịch sử Nhập / Xuất -->
            <Button fx:id="btnHistory" mnemonicParsing="false"
                    styleClass="btn-secondary-history"
                    text="Lịch sử xuất nhập kho" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Ô tìm kiếm -->
            <TextField fx:id="txtSearch" prefWidth="320.0"
                       promptText="Tìm theo mã, tên thuốc..."
                       styleClass="search-input" />
        </HBox>

        <!-- Center: Bảng kép (Dual-table: Bảng dữ liệu cuộn ngang + Cột thao tác ghim cố định nổi bên phải) -->
        <HBox minHeight="300.0" spacing="0.0" styleClass="table-float-container" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
            <!-- Bảng thông tin chính cho cuộn ngang -->
            <TableView fx:id="inventoryTable" HBox.hgrow="ALWAYS" styleClass="custom-inventory-table, table-scrollable-data">
                <columns>
                    <TableColumn fx:id="colCode" minWidth="95.0" prefWidth="105.0" resizable="true" sortable="false" text="Mã thuốc" />
                    <TableColumn fx:id="colName" minWidth="210.0" prefWidth="235.0" resizable="true" sortable="false" text="Tên thuốc" />
                    <TableColumn fx:id="colQuantity" minWidth="95.0" prefWidth="105.0" resizable="true" sortable="false" text="Số lượng" />
                    <TableColumn fx:id="colStockStatus" minWidth="135.0" prefWidth="145.0" resizable="true" sortable="false" style="-fx-alignment: CENTER-LEFT;" text="Tồn kho" />
                    <TableColumn fx:id="colExpiryStatus" minWidth="145.0" prefWidth="155.0" resizable="true" sortable="false" style="-fx-alignment: CENTER-LEFT;" text="Hạn dùng" />
                    <TableColumn fx:id="colPrice" minWidth="115.0" prefWidth="125.0" resizable="true" sortable="false" text="Giá bán" />
                    <TableColumn fx:id="colActiveIngredient" minWidth="250.0" prefWidth="290.0" resizable="true" sortable="false" text="Hoạt chất chính" />
                    <TableColumn fx:id="colCategory" minWidth="270.0" prefWidth="320.0" resizable="true" sortable="false" text="Nhóm" />
                    <TableColumn fx:id="colManufacturer" minWidth="230.0" prefWidth="270.0" resizable="true" sortable="false" text="Nhà sản xuất" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Bảng cột thao tác ghim cố định bên phải (Sticky) -->
            <TableView fx:id="tableActionSticky"
                       minWidth="110.0" prefWidth="110.0" maxWidth="110.0"
                       styleClass="custom-inventory-table, sticky-action-col">
                <columns>
                    <TableColumn fx:id="colAction"
                                 minWidth="80.0" prefWidth="100.0" maxWidth="110.0"
                                 resizable="false" sortable="false"
                                 style="-fx-alignment: CENTER;" text="Thao tác" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </HBox>

        <!-- THANH ĐIỀU HƯỚNG PHÂN TRANG -->
        <HBox alignment="CENTER" prefHeight="36.0" spacing="12.0">
            <VBox.margin>
                <Insets top="24.0" />
            </VBox.margin>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="paginationBox" alignment="CENTER" spacing="6.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblRecordRange"
                   alignment="CENTER"
                   prefHeight="34.0"
                   minWidth="100.0"
                   prefWidth="100.0"
                   maxWidth="100.0"
                   styleClass="pagination-record-badge"
                   text="0 - 0" />
        </HBox>
    </VBox>

    <!-- 2. VIEW LỊCH SỬ XUẤT NHẬP KHO (HIỂN THỊ TRÊN CÙNG MÀN HÌNH KHO THUỐC) -->
    <StackPane fx:id="viewInventoryHistory" visible="false" managed="false" />

</StackPane>