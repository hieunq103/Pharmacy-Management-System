<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="760.0" prefWidth="1200.0" spacing="18.0"
      style="-fx-background-color: #F8FAFC;"
      stylesheets="@../../css/employee.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pharmacy.employee.EmployeeController">

    <padding>
        <Insets bottom="20.0" left="32.0" right="32.0" top="24.0" />
    </padding>

    <!-- Header: Thống kê & (Ô tìm kiếm + Nút thêm nhân viên) -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <VBox spacing="4.0">
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="stat-label-primary" text="Tổng nhân viên:" />
                <Label fx:id="lblTotalEmployees" styleClass="stat-label-primary" text="0" />
            </HBox>
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <Label styleClass="stat-label-secondary" text="Đang làm:" />
                <Label fx:id="lblActiveEmployees" styleClass="stat-label-secondary" text="0" />
            </HBox>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Cụm bên phải: Ô tìm kiếm + Nút Thêm -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <TextField fx:id="txtSearch"
                       promptText="Tìm theo tên, SĐT, CCCD..."
                       prefWidth="280.0"
                       styleClass="search-input" />

            <Button fx:id="btnAddEmployee"
                    onAction="#handleOpenAddDialog"
                    styleClass="btn-primary-add"
                    text="+ Thêm nhân viên" />
        </HBox>
    </HBox>

    <!-- Bảng danh sách: 7 cột -->
<HBox spacing="0.0" VBox.vgrow="ALWAYS" styleClass="table-float-container">
    <TableView fx:id="tableEmployee" styleClass="custom-employee-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" minWidth="170.0" prefWidth="180.0" resizable="true" sortable="false" text="Tên" />
            <TableColumn fx:id="colGender" minWidth="120.0" prefWidth="125.0" resizable="true" sortable="false" text="Giới tính" />
            <TableColumn fx:id="colPhone" minWidth="130.0" prefWidth="130.0" resizable="true" sortable="false" text="SĐT" />
            <TableColumn fx:id="colCccd" minWidth="140.0" prefWidth="150.0" text="CCCD" />
            <TableColumn fx:id="colRole" minWidth="130.0" prefWidth="150.0" resizable="true" sortable="false" text="Vai trò" />
            <TableColumn fx:id="colStatus" minWidth="120.0" prefWidth="120.0" resizable="true" sortable="false" text="Nhân sự" />
            <TableColumn fx:id="colAccountStatus" minWidth="130.0" prefWidth="130.0" resizable="true" sortable="false" text="Tài khoản" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

    </TableView>
    <TableView fx:id="tableActionSticky"
               minWidth="110.0" prefWidth="110.0" maxWidth="110.0"
               styleClass="custom-employee-table, sticky-action-col">
        <columns>
            <TableColumn fx:id="colAction"
                         minWidth="108.0" prefWidth="108.0" maxWidth="108.0"
                         resizable="false" sortable="false"
                         style="-fx-alignment: CENTER;" text="Thao tác" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</HBox>

    <!-- THANH ĐIỀU HƯỚNG PHÂN TRANG -->
    <HBox alignment="CENTER" prefHeight="54.0" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <HBox fx:id="paginationBox" alignment="CENTER" spacing="6.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblRecordRange"
               alignment="CENTER"
               prefHeight="42.0"
               minWidth="100.0"
               prefWidth="100.0"
               maxWidth="100.0"
               styleClass="pagination-record-badge"
               text="0 - 0" />
    </HBox>
</VBox>