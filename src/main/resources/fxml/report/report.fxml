<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="report-scroll-pane"
            stylesheets="@../../css/report.css, @../../css/inventory.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pharmacy.report.ReportController">

    <content>
        <VBox spacing="10.0" styleClass="report-root">
            <padding>
                <Insets bottom="12.0" left="18.0" right="18.0" top="8.0" />
            </padding>

            <!-- ==================== HÀNG 1: BỘ LỌC THỜI GIAN ==================== -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-card">
                <!-- Ô 1: BỘ LỌC THEO NGÀY (GIỮ NGUYÊN BÊN TRÁI) -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Button fx:id="btnFilterDay" onAction="#handleSelectDayMode" styleClass="period-pill-btn, active" text="Theo ngày" />
                    <DatePicker fx:id="dpSelectedDate" prefWidth="135.0" promptText="dd/MM/yyyy" styleClass="date-filter-picker" onAction="#handleDatePicked" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Ô 2: BỘ LỌC THEO THÁNG (DẠT THẲNG HÀNG SÁT VỀ BÊN PHẢI) -->
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button fx:id="btnFilterMonth" onAction="#handleSelectMonthMode" styleClass="period-pill-btn" text="Theo tháng" />
                    <TextField fx:id="txtFilterYear" prefWidth="70.0" alignment="CENTER" promptText="Năm" styleClass="year-text-input" onAction="#handleYearAction" />
                    <ComboBox fx:id="cbFilterMonth" prefWidth="110.0" promptText="Tháng" styleClass="combo-filter-box" onAction="#handleMonthChanged" />
                </HBox>
            </HBox>

            <!-- ==================== HÀNG 2: 5 THẺ THỐNG KÊ (STAT CARDS) ==================== -->
            <GridPane hgap="12.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS" />
                    <ColumnConstraints percentWidth="20.0" hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="66.0" prefHeight="66.0" valignment="CENTER" vgrow="ALWAYS" />
                </rowConstraints>

                <!-- THẺ 1: TỔNG DOANH SỐ -->
                <VBox spacing="4.0" styleClass="report-stat-card" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-title" text="Tổng doanh số" />
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="stat-icon-pill, stat-icon-pill-blue">
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-.81-.62-1.8-2.5-1.8-1.57 0-2.3.72-2.3 1.54 0 .8.54 1.44 2.55 1.9 2.7.63 4.3 1.62 4.3 3.84 0 1.91-1.39 3.03-3.94 3.27z" styleClass="stat-svg" />
                        </StackPane>
                    </HBox>
                    <Label fx:id="lblTotalRevenue" styleClass="stat-value-highlight" text="0đ" />
                </VBox>

                <!-- THẺ 2: TIỀN MẶT -->
                <VBox spacing="4.0" styleClass="report-stat-card" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-title" text="Tiền mặt" />
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="stat-icon-pill, stat-icon-pill-emerald">
                            <SVGPath content="M21 6H3c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h18c.55 0 1-.45 1-1V7c0-.55-.45-1-1-1zm-1 10H4V8h16v8z M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" styleClass="stat-svg" />
                        </StackPane>
                    </HBox>
                    <Label fx:id="lblCashRevenue" styleClass="stat-value" text="0đ" />
                </VBox>

                <!-- THẺ 3: CHUYỂN KHOẢN -->
                <VBox spacing="4.0" styleClass="report-stat-card" GridPane.columnIndex="2">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-title" text="Chuyển khoản" />
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="stat-icon-pill, stat-icon-pill-amber">
                            <SVGPath content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" styleClass="stat-svg" />
                        </StackPane>
                    </HBox>
                    <Label fx:id="lblTransferRevenue" styleClass="stat-value" text="0đ" />
                </VBox>

                <!-- THẺ 4: SỐ THUỐC ĐÃ BÁN -->
                <VBox spacing="4.0" styleClass="report-stat-card" GridPane.columnIndex="3">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-title" text="Số thuốc đã bán" />
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="stat-icon-pill, stat-icon-pill-green">
                            <SVGPath content="M4.5 10.5C3.67 10.5 3 11.17 3 12s.67 1.5 1.5 1.5h15c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5h-15z M10.5 4.5C10.5 3.67 11.17 3 12 3s1.5.67 1.5 1.5v15c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5v-15z" styleClass="stat-svg" />
                        </StackPane>
                    </HBox>
                    <Label fx:id="lblTotalMedicinesSold" styleClass="stat-value-emerald" text="0 sản phẩm" />
                </VBox>

                <!-- THẺ 5: TỔNG SỐ HÓA ĐƠN -->
                <VBox spacing="4.0" styleClass="report-stat-card" GridPane.columnIndex="4">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-title" text="Tổng hóa đơn" />
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="stat-icon-pill, stat-icon-pill-purple">
                            <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="stat-svg" />
                        </StackPane>
                    </HBox>
                    <Label fx:id="lblTotalOrders" styleClass="stat-value" text="0 đơn" />
                </VBox>
            </GridPane>

            <!-- ==================== HÀNG 3: TABPANE CHI TIẾT ==================== -->
            <TabPane fx:id="tabPaneReport" styleClass="report-tab-pane" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <!-- TAB 1: BÁO CÁO DOANH SỐ -->
                    <Tab fx:id="tabRevenue" text="📊 Báo cáo Doanh số">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="8.0" />
                                </padding>

                                <!-- Biểu đồ doanh số -->
                                <VBox spacing="8.0" styleClass="chart-card">
                                    <Label fx:id="lblChartTitle" styleClass="section-title" text="Biểu đồ doanh số 7 ngày gần nhất" />
                                    <BarChart fx:id="barChartRevenue" legendVisible="false"
                                              styleClass="report-bar-chart"
                                              minHeight="260.0" prefHeight="330.0"
                                              animated="false"
                                              categoryGap="24.0" barGap="4.0"
                                              horizontalGridLinesVisible="false" verticalGridLinesVisible="false">
                                        <xAxis>
                                            <CategoryAxis fx:id="chartXAxis" animated="false" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="chartYAxis" animated="false" />
                                        </yAxis>
                                    </BarChart>
                                </VBox>
                            </VBox>
                        </content>
                    </Tab>

                    <!-- TAB 2: BÁO CÁO SỐ THUỐC ĐÃ BÁN -->
                    <Tab fx:id="tabMedicines" text="💊 Báo cáo Số thuốc đã bán">
                        <content>
                            <VBox spacing="10.0">
                                <padding>
                                    <Insets top="8.0" />
                                </padding>

                                <!-- Biểu đồ số thuốc đã bán -->
                                <VBox spacing="8.0" styleClass="chart-card">
                                    <Label fx:id="lblMedChartTitle" styleClass="section-title" text="Biểu đồ sản lượng thuốc đã bán 7 ngày gần nhất" />
                                    <BarChart fx:id="barChartMedicines" legendVisible="false"
                                              styleClass="report-bar-chart, report-bar-chart-green"
                                              minHeight="260.0" prefHeight="330.0"
                                              animated="false"
                                              categoryGap="24.0" barGap="4.0"
                                              horizontalGridLinesVisible="false" verticalGridLinesVisible="false">
                                        <xAxis>
                                            <CategoryAxis fx:id="chartMedXAxis" animated="false" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="chartMedYAxis" animated="false" />
                                        </yAxis>
                                    </BarChart>
                                </VBox>

                                <!-- Bảng chi tiết sản lượng từng thuốc -->
                                <VBox spacing="12.0" styleClass="content-card">
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label styleClass="section-title" text="Bảng chi tiết sản lượng từng mặt hàng thuốc" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtSearchMedicine" prefWidth="320.0" promptText="Tìm nhanh theo tên, mã thuốc, nhóm..." styleClass="search-input" />
                                    </HBox>

                                    <VBox styleClass="table-float-container">
                                        <TableView fx:id="tblSoldMedicines" prefHeight="425.0" styleClass="custom-inventory-table, table-scrollable-data">
                                            <columns>
                                                <TableColumn fx:id="colMedIndex" minWidth="60.0" prefWidth="70.0" resizable="true" text="STT" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedCode" minWidth="110.0" prefWidth="120.0" resizable="true" text="Mã thuốc" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedName" minWidth="260.0" prefWidth="300.0" resizable="true" text="Tên thuốc" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedCategory" minWidth="280.0" prefWidth="330.0" resizable="true" text="Nhóm thuốc" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedUnit" minWidth="100.0" prefWidth="110.0" resizable="true" text="Đơn vị" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedQtySold" minWidth="130.0" prefWidth="140.0" resizable="true" text="Số lượng bán" style="-fx-alignment: CENTER-LEFT;" />
                                                <TableColumn fx:id="colMedRevenue" minWidth="150.0" prefWidth="170.0" resizable="true" sortable="false" text="Doanh thu" style="-fx-alignment: CENTER;" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </VBox>

                                    <!-- THANH ĐIỀU HƯỚNG PHÂN TRANG -->
                                    <HBox alignment="CENTER" prefHeight="36.0" spacing="12.0">
                                        <padding>
                                            <Insets top="8.0" bottom="4.0" />
                                        </padding>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox fx:id="paginationBox" alignment="CENTER" spacing="6.0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblRecordRange"
                                               alignment="CENTER"
                                               prefHeight="34.0"
                                               minWidth="100.0"
                                               prefWidth="100.0"
                                               maxWidth="100.0"
                                               styleClass="pagination-record-badge"
                                               text="0 - 0" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </content>
</ScrollPane>
